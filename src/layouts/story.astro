---
const { frontmatter } = Astro.props;
import '../styles/global.styl';

const themeScriptUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/theme.js`;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />
	<title>{frontmatter.title} | 中传神人录</title>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fancyapps/ui@6.1.15/dist/fancybox/fancybox.css" />
	<script is:inline defer src="https://cdn.jsdelivr.net/npm/@fancyapps/ui@6.1.15/dist/fancybox/fancybox.umd.js"></script>
	<script is:inline defer src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/image-trays.js`}></script>
	<script is:inline defer src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/media-viewer.js`}></script>
	<script is:inline defer src={themeScriptUrl}></script>
</head>
<body>
	<div class="page-shell">
		<nav class="site-nav" aria-label="主导航">
			<div class="site-nav__side">
				<a class="site-nav__back" href="/shenrenlu/">返回首页</a>
			</div>
			<a class="site-nav__title" href="/shenrenlu/">{frontmatter.title}</a>
			<div class="site-nav__side site-nav__side--end">
				<button class="theme-toggle" type="button" aria-label="切换深色模式" title="切换深色模式">
					<span class="theme-toggle__icon" aria-hidden="true"></span>
				</button>
			</div>
		</nav>
		<main class="page-content">
			<article>
				<slot />
			</article>
		</main>
	</div>
</body>
</html>