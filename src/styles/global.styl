:root {
	color-scheme: light;
	--canvas: #f6f7f3;
	--text: #24312d;
	--muted: #64716a;
	--accent: #426d60;
	--rule: #d6ded8;
	--hover: #e9eeea;
}

:root[data-theme='dark'] {
	color-scheme: dark;
	--canvas: #19231f;
	--text: #e2e9e4;
	--muted: #a8b7ad;
	--accent: #9bc8b5;
	--rule: #35443c;
	--hover: #27332d;
}

* {
	box-sizing: border-box;
}

html {
	background: var(--canvas);
	color: var(--text);
	font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
	font-size: 16px;
	line-height: 1.8;
}

body {
	margin: 0;
}

a {
	color: var(--accent);
	text-decoration-color: var(--muted);
	text-decoration-thickness: 1px;
	text-underline-offset: 0.2em;
}

a:hover {
	text-decoration-color: currentColor;
}

button {
	font: inherit;
}

.page-shell {
	max-width: 56rem;
	margin: 0 auto;
	padding: 0 1.5rem 4rem;
}

.site-nav {
	display: grid;
	grid-template-columns: 1fr auto 1fr;
	align-items: center;
	min-height: 4.5rem;
	border-bottom: 1px solid var(--rule);
}

.site-nav__side {
	min-width: 0;
}

.site-nav__side--end {
	display: flex;
	justify-content: flex-end;
}

.site-nav__title {
	color: inherit;
	font-size: 1.25rem;
	font-weight: 600;
	letter-spacing: 0.08em;
	text-decoration: none;
	white-space: nowrap;
}

.site-nav__back {
	color: var(--accent);
	font-size: 0.875rem;
	text-decoration: none;
}

.site-nav__back::before {
	content: '< ';
}

.theme-toggle {
	display: grid;
	width: 2rem;
	height: 2rem;
	padding: 0;
	place-items: center;
	background: transparent;
	border: 1px solid var(--rule);
	border-radius: 50%;
	color: inherit;
	cursor: pointer;
}

.theme-toggle:hover {
	background: var(--hover);
}

.theme-toggle:focus-visible,
a:focus-visible {
	outline: 2px solid currentColor;
	outline-offset: 3px;
}

.theme-toggle__icon {
	width: 0.7rem;
	height: 0.7rem;
	border: 1.5px solid currentColor;
	border-radius: 50%;
}

:root[data-theme='dark'] .theme-toggle__icon {
	border-color: transparent;
	box-shadow: -0.2rem -0.1rem 0 0 currentColor;
}

.page-content {
	padding-top: 2.75rem;
}

h2,
h3 {
	font-weight: 600;
	line-height: 1.35;
}

h2 {
	margin: 2.5rem 0 1rem;
	color: var(--accent);
	font-size: 1.25rem;
}

h3 {
	margin: 2rem 0 0.75rem;
	font-size: 1.0625rem;
}

p,
li {
	text-align: justify;
	text-justify: inter-character;
}

p,
ul,
ol {
	margin: 0 0 1.25rem;
}

ul,
ol {
	padding-left: 1.5rem;
}

li + li {
	margin-top: 0.25rem;
}

article > p:has(> img:only-child) {
	text-align: center;
}

article > p:has(> img:only-child) > img:not([width]):not([height]) {
	display: block;
	max-width: 75%;
	height: auto;
	margin: 0 auto;
}

@media (max-width: 32rem) {
	.page-shell {
		padding-right: 1rem;
		padding-left: 1rem;
	}

	.site-nav {
		min-height: 4rem;
	}

	.site-nav__title {
		font-size: 1.0625rem;
	}

	.site-nav__back {
		font-size: 0;
	}

	.site-nav__back::before {
		font-size: 1.25rem;
	}

	.page-content {
		padding-top: 2rem;
	}

	article > p:has(> img:only-child) > img:not([width]):not([height]) {
		max-width: 100%;
	}
}